{
  "name": "mumimap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --remote > src/types/database.ts",
    "data:check": "tsx --env-file=.env.local scripts/import.ts",
    "data:apply": "tsx --env-file=.env.local scripts/import.ts --apply",
    "data:crawl:funhero": "tsx scripts/crawl-funhero.ts",
    "data:link-kakao": "tsx --env-file=.env.local scripts/link-kakao-places.ts",
    "data:crawl:redbutton": "tsx scripts/crawl-redbutton.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.106.1",
    "next": "16.4.5",
    "nuqs": "^2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-kakao-maps-sdk": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "csv-parse": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "kakao.maps.d.ts": "^0.1.40",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.11.1"
}
